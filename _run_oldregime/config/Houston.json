{
  "dataset": "Houston",
  "dataroot": "./data",
  "train_num": 0.2,
  "attribute_dir": "./attributes/",
  "pretrain_loc": "./extract_text/ViT-L-14.pt",
  "random_seed": 114514,    
  "device": "cuda:0",
  "flip_augmentation": true,
  "radiation_augmentation": true,
  "mixture_augmentation": false,
  "patch_size": 11,
  "batch_size": 1024,
  "epochs": 150,
  "lr": 0.0002,
  "pin_memory": true,
  "center_pixel": true,
  "supervision": "full",
  "checkpoints": 10,
  "lambda_clip": 0.6,
  "vision_dim": 128,
  "dropout": 0.1,
  "spectral_dim": 128,
  "multi_args": true,
  "unseen_classes": ["Healthy grass", "Synthetic grass", "Water"],
  "spectral_ratio": 0.2,
  "dynamic_fusion": false,
  "fusion_temperature": 0.07,
  "fusion_prior_strength": 1.0,
  "fusion_min_weight": 0.05,
  "use_zscore": false,
  "use_balanced_sampler": false,
  "use_unseen_negatives": false,
  "use_logit_adjust": false,
  "use_virtual_prototypes": false,
  "only_name": false
}
