  "lambda_clip": 0.8,
  "vision_dim": 128,
  "dropout": 0.1,
  "spectral_dim": 128,
  "multi_args": true,
  "unseen_classes": ["Healthy grass", "Synthetic grass", "Water"],
  "spectral_ratio": 0.2,
  "only_name": false
}