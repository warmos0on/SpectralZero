{
  "dataset": "Houston",
  "dataroot": "./data",
  "train_num": 0.2,
  "attribute_dir": "./attributes/",
  "pretrain_loc": "./extract_text/ViT-L-14.pt",
  "random_seed": 114514,
  "device": "cuda:0",
  "flip_augmentation": true,
